vars: {
  d2-config: {
    layout-engine: tala
    theme-id: 0
    dark-theme-id: 200
    pad: 20
  }
  src: https://github.com/levante-framework/core-tasks/blob/aaead211dbcff5d5af88bab383d7604cec456846/task-launcher/src
}

direction: down

classes: {
  fn: {style.font: mono}
  store: {shape: cylinder}
  dash: {style.stroke-dash: 4}
}

dashboard: "levante-dashboard" {
  style.stroke-dash: 4

  VD: "Variant doc (Firestore)" {class: store}
  FK: |md
    **Firekit CF** `startTask()`

    returns `variantName`, `variantParams`, `variantId`
  | {shape: rectangle}
  UD: "User doc (Firestore)" {class: store}
  Q: |md
    `useUserChildDataQuery`

    `birthMonth`, `birthYear` (required)\
    `studentData`, `userType` (unused)
  | {shape: rectangle}
  TL: "TaskLevante.vue" {class: fn}

  VD -> FK: "startAssessmentWithRetry()"
  FK -> TL
  UD -> Q
  Q -> TL
}

LAUNCH: |ts
  new TaskLauncher(firekit, gameParams, userParams, logger)
| {
  link: "${src}/index.ts#L32-L43"
  tooltip: "gameParams = { ...appKit._taskInfo.variantParams }; userParams = { birthMonth, birthYear }"
}
dashboard.TL -> LAUNCH: "gameParams + userParams"

INIT: "init()" {
  link: "${src}/index.ts#L45-L115"
  label.near: top-left
  direction: down

  S1: "1. firekit.startRun()" {class: fn; link: "${src}/index.ts#L46-L48"}
  S2: "2. taskName / language read raw" {class: fn; link: "${src}/index.ts#L50-L61"}
  S3: "3. setConfig() → setSharedConfig()" {class: fn; link: "${src}/tasks/shared/helpers/config.ts#L63-L68"}
  S4: "4. setTaskStore(config)" {class: fn; link: "${src}/taskStore/index.ts#L132"}
  S5: "5. getCorpus(config)" {class: fn; link: "${src}/tasks/shared/helpers/getCorpus.ts#L180"}
  S6: "6. buildTaskTimeline(config)" {class: fn; link: "${src}/index.ts#L114"}
  S1 -> S2 -> S3 -> S4 -> S5 -> S6
}
LAUNCH -> INIT

RUN: |md
  **RUN DOC**

  `variantParams` + `userData`

  userData comes straight from the user doc, not `userParams` (includes `assessmentPid`, `grade`, …)
| {class: store}
ASSETS: "assets, translations"
CFG: |ts
  const cleanParams = _omitBy(
    _omitBy({ ...gameParams, ...userParams }, _isNull),
    _isUndefined,
  );
  // → destructured, then explicit defaults + coercion
| {link: "${src}/tasks/shared/helpers/config.ts#L68"}
STORE: "taskStore\n(what trials read)" {link: "${src}/taskStore/index.ts"}
CORPUS: "corpus CSV"
TRIALS: "trials"
TDOCS: "TRIAL DOCS" {class: store}

INIT.S1 -> RUN
INIT.S2 -> ASSETS
INIT.S3 -> CFG
INIT.S4 -> STORE
INIT.S5 -> CORPUS
INIT.S6 -> TRIALS
TRIALS -> TDOCS
